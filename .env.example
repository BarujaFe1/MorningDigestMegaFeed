# Morning Digest does not require API keys.
# Optional future settings (documented for portfolio / DX clarity):

# Path override for config file (default: ./news_config.json)
# MORNING_DIGEST_CONFIG=./news_config.json

# Request timeout in seconds for RSS fetches (default: 8)
# MORNING_DIGEST_TIMEOUT=8

# Set to 1 to prefer demo feeds on launch (not wired by default)
# MORNING_DIGEST_DEMO=0
